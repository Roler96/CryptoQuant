# =====================================================================
# CryptoQuant Environment Variables (.env)
# Copy this to .env and fill in your credentials.
# NEVER commit .env to version control.
# =====================================================================

# --- OKX API Credentials ---
# Get these from OKX: https://www.okx.com/account/my-api
OKX_API_KEY=your_api_key_here
OKX_API_SECRET=your_api_secret_here
OKX_PASSPHRASE=your_passphrase_here

# --- Proxy (optional) ---
# Uncomment if behind a corporate firewall / using a proxy
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080

# --- Alert Webhook (optional) ---
# Discord, Slack, or custom webhook URL for critical alerts
# ALERT__WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
